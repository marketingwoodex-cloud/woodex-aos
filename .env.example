# Woodex AOS — environment configuration
# Copy to .env and adjust. Every value has a safe development default.

PORT=3000
HOST=0.0.0.0

# Session signing secret (CHANGE IN PRODUCTION)
JWT_SECRET=woodex-aos-local-dev-secret-change-me

# Database location (defaults to server/data/woodex.db)
# DB_PATH=./server/data/woodex.db

# Default currency + tax used by the commerce module
DEFAULT_CURRENCY=PKR
TAX_RATE=5

# Seed demo data on first boot (true/false)
AUTO_SEED=true
